# Copy to .env. Fill only the providers you use; do not commit real keys.
# 每个使用者必须填写自己在对应供应商申请的 Token / API Key；项目不提供共享密钥。
# 未填写的供应商无法生成；同一供应商的模型可共用该账号的密钥。
# 修改后重启本地服务。不要把密钥写成 NEXT_PUBLIC_* 或提交到 GitHub。
# All project records and media are local. No DB, cloud object storage or business backend is needed.
LOCAL_DATA_DIR=./data
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SONYFLAKE_MACHINE_ID=1

# OpenAI or a compatible model provider (include the host, without /v1).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
# Optional Azure alternative: set both endpoint and key.
AZURE_OPENAI_TEXT_ENDPOINT=
AZURE_OPENAI_TEXT_API_KEY=

# Google Vertex AI (Gemini / Nano Banana / Veo): your own service account.
NANO_BANANA_SERVICE_ACCOUNT_JSON_B64=
# Or a credentials file outside this repository:
GOOGLE_APPLICATION_CREDENTIALS=

# Alibaba DashScope (Qwen images, Wan videos).
DASHSCOPE_API_KEY=
# Volcengine Ark (Seedance).
SEEDANCE_API_KEY=
SEEDANCE_20_BASE_URL=https://ark.cn-beijing.volces.com
SEEDANCE_20_MODEL=
SEEDANCE_25_BASE_URL=https://ark.cn-beijing.volces.com
SEEDANCE_25_MODEL=
# Optional portrait input support; credentials belong to your provider account.
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=

# Optional HiModels supplier; one personal key works in dev and production.
HIMODELS_API_KEY=
HIMODELS_BASE_URL=https://api.himodels.ai

# FFmpeg and ffprobe must be installed locally (or set explicit binary paths).
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
VIDEO_LANGUAGE=zh
